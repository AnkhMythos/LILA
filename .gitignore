# ============================================================
# .gitignore para LILA
# ============================================================

# ------------------------------------------------------------
# Node.js
# ------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/
.yarn/
.pnp.*
.pnp.js

# ------------------------------------------------------------
# Variables de entorno y secretos
# ------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development
.env.production
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------
# Datos locales de LILA (NO subir al repo)
# ------------------------------------------------------------
# Bases SQLite y sus archivos auxiliares (WAL, SHM)
backend/data/
backend/src/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Historial de memoria (JSON)
backend/data/memory.json
backend/src/data/memory.json

# Configuración local de MCP (puede tener rutas o tokens propios)
# Si querés subir el mcp-servers.json de ejemplo, sacá esta línea
backend/mcp-servers.local.json

# ------------------------------------------------------------
# Archivos subidos por el usuario
# ------------------------------------------------------------
uploads/
backend/uploads/
frontend/uploads/
backend/data/uploads/

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------
logs/
*.log
backend/logs/
backend/*.log

# ------------------------------------------------------------
# Sistema operativo
# ------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.Trash-*

# ------------------------------------------------------------
# Editores / IDEs
# ------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# JetBrains (WebStorm, IntelliJ, etc.)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*.swn
.vim/

# Emacs
*~
\#*\#
.\#*

# ------------------------------------------------------------
# Build / dist / compilados
# ------------------------------------------------------------
dist/
build/
out/
*.tsbuildinfo
.eslintcache
.stylelintcache

# ------------------------------------------------------------
# Testing / coverage
# ------------------------------------------------------------
coverage/
.nyc_output/
*.lcov

# ------------------------------------------------------------
# Caches varios
# ------------------------------------------------------------
.cache/
.parcel-cache/
.next/
.nuxt/
.vuepress/dist/
.temp/
.tmp/
temp/
tmp/

# ------------------------------------------------------------
# Python (para el endpoint /python)
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------
# Archivos temporales de Ollama / MCP
# ------------------------------------------------------------
.ollama/
*.ollama-tmp
mcp-logs/
*.mcp.log

# ------------------------------------------------------------
# Otros archivos específicos de LILA
# ------------------------------------------------------------
# Backups locales de exportaciones
lila_export_*.json
respuesta_*.txt
codigo.*
!codigo.js
!codigo.py

# Archivos de prueba personales
scratch/
sandbox/
playground/
test-local/
*.local.js
*.local.json

# ------------------------------------------------------------
# Lockfiles (elegí uno)
# ------------------------------------------------------------
# Si usás npm, dejá solo package-lock.json
# Si usás yarn, dejá solo yarn.lock
# Si usás pnpm, dejá solo pnpm-lock.yaml
# Comentá los que no uses.
# yarn.lock
# pnpm-lock.yaml